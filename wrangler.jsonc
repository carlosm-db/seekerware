// Worker config. Secrets NEVER here (they live in Worker secrets, see TRD §9).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "seekerware",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "observability": { "enabled": true },
  // Dumb hourly tick, 24/7. Whether a tick RUNS is decided by the owner-editable
  // D1 config `schedule` (console /health panel) — window/cadence changes need
  // no deploy. Skipped ticks exit immediately (near-zero cost).
  "triggers": { "crons": ["0 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "seekerware",
      "database_id": "f9e94936-ecac-4d34-b2e1-eb038f0995ea"
    }
  ]
}
